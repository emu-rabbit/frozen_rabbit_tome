{
  "name": "frozen_rabbit_tome",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "wasm:collectable:build": "asc assembly/collectableSolverCore.ts -o src/wasm/collectable-solver-core.wasm -t scratch/collectable-solver-core.wat -O --noAssert",
    "wasm:regular:build": "asc assembly/regularGatheringSolverCore.ts -o src/wasm/regular-gathering-solver-core.wasm -t scratch/regular-gathering-solver-core.wat -O --noAssert",
    "bench:collectable-wasm": "npm run wasm:collectable:build && vitest run --config vitest.bench.config.ts --reporter verbose",
    "bench:regular-wasm": "npm run wasm:regular:build && vitest run --config vitest.bench.config.ts scripts/regular-gathering-wasm.bench.ts --reporter verbose"
  },
  "dependencies": {
    "@primevue/themes": "^4.5.4",
    "@vueuse/core": "^14.2.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "vue": "^3.5.32",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.4.5",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "assemblyscript": "^0.28.17",
    "autoprefixer": "^10.4.27",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.3",
    "vue-tsc": "^3.2.6"
  }
}
